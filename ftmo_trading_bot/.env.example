# ==========================================
# FTMO Trading Bot - Environment Variables
# ก๊อปปี้ไฟล์นี้และตั้งชื่อเป็น ".env" (ไม่มี .example) ก่อนรันบอท
# ==========================================

# 📊 MT5 Configuration
# --------------------
# เส้นทางไฟล์ของ MT5 ในเครื่อง
# ⚠️ ใช้ forward slash (/) แทน backslash (\) เพื่อกัน python-dotenv
#    interprete \t, \n, \r เป็น escape sequences ทำให้ path เพี้ยน
MT5_TERMINAL_PATH="C:/Program Files/MetaTrader 5/terminal64.exe"
# หมายเลขบัญชี MT5 ของคุณ
MT5_LOGIN=YOUR_MT5_LOGIN_NUMBER
# รหัสผ่านบัญชี
MT5_PASSWORD="YOUR_MT5_PASSWORD"
# โบรกเกอร์เซิร์ฟเวอร์
MT5_SERVER="FTMO-Demo"

# 📱 Discord Notification Configuration
# -------------------------------------
# เปิดใช้งานแจ้งเตือนไปยัง Discord (True/False)
DISCORD_ENABLE=True
# Webhook URL ของห้อง Text Channel เป้าหมายใน Discord
DISCORD_WEBHOOK_URL="YOUR_DISCORD_WEBHOOK_URL"
