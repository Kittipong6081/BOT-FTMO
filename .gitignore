ftmo_trading_bot/models/mr/best_iter*/
ftmo_trading_bot/models/mr/best_*pass*/

# TF (Fix#2) pipeline — Phase 1 intermediates (track เฉพาะ models/tf/best/ + ppo_tf_filter.zip + vec_normalize_tf.pkl)
ftmo_trading_bot/models/tf/ppo_tf_filter_p1.zip
ftmo_trading_bot/models/tf/vec_normalize_tf_p1.pkl
