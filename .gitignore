# News cache (auto-downloaded)
ftmo_trading_bot/config/news_inbox/*.json
!ftmo_trading_bot/config/news_inbox/README.md

# State files (per-machine runtime state)
ftmo_trading_bot/data/bot_state.json

# Training-only data — pool .pkl ไม่ track (ใหญ่ + rebuild ได้)
# Live ไม่ต้องการ pool — ต้องการแค่ ML quality model + RL model
# track เฉพาะ .pkl.gz (compressed) เพื่อ VPS pull ได้ ถ้าจะ retrain
ftmo_trading_bot/data/signal_pool_*.pkl
!ftmo_trading_bot/data/signal_pool_*.pkl.gz
# v8.0 MR pool (~309 MB) — rebuild ได้บน Mac ผ่าน auto_train_pipeline
ftmo_trading_bot/data/mr_signal_pool_*.pkl
!ftmo_trading_bot/data/mr_signal_pool_*.pkl.gz
# v8.1 TF pool (~36 MB @ 3000) — rebuild ได้ผ่าน auto_train_pipeline_tf
ftmo_trading_bot/data/tf_signal_pool_*.pkl
!ftmo_trading_bot/data/tf_signal_pool_*.pkl.gz

# OHLCV bars (~110 MB) — regenerate via scripts/fetch_mt5_data.py.
# Live fetches rates from MT5 directly (ไม่อ่าน CSV) → live ไม่ต้องการ; training re-fetch ได้
ftmo_trading_bot/data/ohlcv/
ftmo_trading_bot/data/ohlcv_*/
# Local data snapshots / forensic backups
ftmo_trading_bot/data/backup*/
# Trade-log workbooks (history/privacy; bot สร้างใหม่บนเครื่อง live เอง)
ftmo_trading_bot/logs/*.xlsx
ftmo_trading_bot/logs/eval/
# Raw news downloads (parsed → news_calendar.json which IS tracked)
ftmo_trading_bot/config/news_inbox/*.csv
# Model backup / validation variants (track เฉพาะ best/ + live zips)
*_validated
*.pre_trim*

# Legacy models (v1-v5, ไม่ใช้แล้ว — keep เฉพาะ ppo_signal_filter.zip + vec_normalize_sf.pkl)
